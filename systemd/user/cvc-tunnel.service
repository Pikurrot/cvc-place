[Unit]
Description=CVC SSH port forward for WhoIsIn (scripts/cvc_tunnel.sh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Repo at ~/cvc-place — if elsewhere, change /home/eric_server/repos/cvc-place in all three units.
WorkingDirectory=/home/eric_server/repos/cvc-place
EnvironmentFile=-/home/eric_server/repos/cvc-place/.env
ExecStart=/home/eric_server/repos/cvc-place/scripts/cvc_tunnel.sh
Restart=always
RestartSec=8
User=eric_server
Group=eric_server

[Install]
WantedBy=multi-user.target
