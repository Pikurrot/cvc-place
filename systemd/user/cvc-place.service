[Unit]
Description=cvc-place HTTP server
After=network-online.target cvc-tunnel.service
Requires=cvc-tunnel.service
Wants=cvc-place-worker.service

[Service]
Type=simple
WorkingDirectory=/home/eric_server/repos/cvc-place
EnvironmentFile=-/home/eric_server/repos/cvc-place/.env
ExecStart=/usr/bin/python3 /home/eric_server/repos/cvc-place/server.py
Restart=on-failure
RestartSec=5
User=eric_server
Group=eric_server

[Install]
WantedBy=multi-user.target
Also=cvc-tunnel.service
Also=cvc-place-worker.service
